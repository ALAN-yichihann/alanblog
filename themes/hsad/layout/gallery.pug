extends ./_partial/base.pug

block content
  - var entries = typeof hsad_background_entries === 'function' ? hsad_background_entries() : []
  section.page-intro
    h1.page-intro__title= page.title || '图库'
    p.page-intro__description= page.description || '用于左侧栏随机背景的所有图片。'
  if page.content
    .article.article--page
      .article__content
        != page.content
  if entries.length
    .gallery-grid
      each item in entries
        figure.gallery-card
          a.gallery-card__media(href=item.url target='_blank' rel='noopener' aria-label=(item.name || item.file))
            img(src=item.url alt=(item.name || item.file) loading='lazy' decoding='async')
          figcaption.gallery-card__body
            p.gallery-card__name= item.name || item.file
            if item.work
              p.gallery-card__meta 作品：#{item.work}
            if item.source
              p.gallery-card__meta 来源：#{item.source}
            if item.author
              p.gallery-card__meta 作者：#{item.author}
  else
    .empty-state
      p.empty-state__title 还没有登记图片
      p.empty-state__text 在 source/_data/backgrounds.yml 里登记后，这里会显示图片与出处信息。
